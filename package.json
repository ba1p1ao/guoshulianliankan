{
  "name": "guoshu-llk",
  "version": "1.0.4",
  "description": "果蔬连连看 - electron-vite 单机版",
  "main": "out/main/index.js",
  "author": "",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run dist:setup && npm run dist:portable",
    "dist:setup": "electron-vite build && electron-builder --win --config.win.target=nsis --config.win.artifactName='${name}-${version}-setup.${ext}'",
    "dist:portable": "electron-builder --win --config.win.target=portable --config.win.artifactName='${name}-${version}-portable.${ext}'"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.guoshu.llk",
    "productName": "果蔬连连看",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "ba1p1ao",
      "repo": "guoshulianliankan"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "perMachine": false
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
